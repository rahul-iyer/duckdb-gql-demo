{
  "name": "duckdb-gql-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:playground && npm run docs:build",
    "build:playground": "tsc --noEmit && vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev61.0",
    "@duckdb/duckdb-wasm-shell": "1.33.1-dev61.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitepress": "1.6.4",
    "web-worker": "^1.2.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
